# JoyPi SSH access (use a reserved DHCP address or a resolvable hostname)
JOYPI_SSH_HOST=192.168.1.50
JOYPI_SSH_USER=pi
JOYPI_SSH_PORT=22
JOYPI_SSH_KEY_PASSPHRASE=

# Set these to the JoyPi user's actual home directory and venv path.
JOYPI_PYTHON=/home/pi/homelab-monitoring/.venv/bin/python
JOYPI_AGENT_PATH=/home/pi/homelab-monitoring/sensor_agent.py

JOYPI_SSH_TIMEOUT_SECONDS=8
SENSOR_CACHE_SECONDS=10
